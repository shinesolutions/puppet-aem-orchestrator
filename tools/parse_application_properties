#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Parse an example application.properties file and generate a Puppet class."""

import argparse
import sys
import textwrap
from pathlib import Path
from typing import TextIO

import case_conversion
import javaproperties
from jinja2 import Template

__version__ = '0.1'


def unwrap(txt: str) -> str:
    """Remove indentations and format text block into a single line."""
    return ' '.join(textwrap.wrap(textwrap.dedent(txt).strip()))


def parse_args() -> argparse.Namespace:
    """Parse the command line arguments and fill in default file paths."""
    p = argparse.ArgumentParser(
        description=unwrap("""
            Parse an example `application.properties` file and generate a
            Puppet class to generate it.
        """),
    )
    p.add_argument(
        '--class-prefix',
        '-p',
        default=None,
        help=unwrap("""
            A prefix for the class name. Usually the name of the class that
            will be including the generated class to generate its
            configuration.
        """),
    )
    p.add_argument(
        '--class-name',
        '-n',
        default=None,
        help=unwrap("""
            The name of the generated class. Default is based on the example
            file name.
        """),
    )
    p.add_argument(
        '--class-file',
        '-f',
        default=None,
        help=unwrap("""
            The Puppet file to write to.
        """),
    )
    p.add_argument(
        '--template-file',
        '-t',
        default=None,
        help=unwrap("""
            The EPP template file to write to.
        """),
    )
    p.add_argument(
        '--spec-file',
        '-s',
        default=None,
        help=unwrap("""
            The Ruby spec file to write to.
        """),
    )
    p.add_argument(
        'file',
        help=unwrap("""
            The example application.properties file to parse.
        """),
    )
    p.add_argument(
        '--acronym',
        default=[],
        action='append',
        help=unwrap("""
            Provide an acronym that will not be split when converting CamelCase
            to snake_case. Can be used multiple times.
        """),
    )
    p.add_argument(
        '--version',
        '-V',
        action='version',
        version=f'%(prog)s {__version__}',
        help='Show version information and exit.',
    )

    args = p.parse_args()

    if args.class_name is None:
        if args.file == '-':
            print(
                'You must provide a class name (--class-name) when example file is stdin.',
                file=sys.stderr,
            )
            raise SystemExit(1)
        args.class_name = Path(args.file).name.replace('.', '_')

    if args.class_file is None:
        args.class_file = f'manifests/{args.class_name}.pp'
    if args.template_file is None:
        args.template_file = f'templates/{args.class_name}.epp'
    if args.spec_file is None:
        args.spec_file = f'spec/classes/{args.class_name}_spec.rb'

    print(f'{args!r}', file=sys.stderr)
    return args


class PropertyKey:
    """Container for property details and case conversions."""

    def __init__(
        self,
        key: str,
        full_class_name: str,
        acronyms: list[str] | None = None,
    ) -> None:
        self.key = key
        self.full_class_name = full_class_name
        self.acronyms = acronyms or []

    @property
    def snake_case(self) -> str:
        """Puppet parameter name for the property key."""
        return case_conversion.snake(self.key, acronyms=self.acronyms)

    @property
    def doco(self) -> str:
        """Puppet Strings description for the parameter."""
        return f'Java property `{self.key}`'


def parse_example_file(
    file: TextIO, full_class_name: str, acronyms: list[str]
) -> list[PropertyKey]:
    """Read the property keys from an example application.properties file."""
    keys = []
    for key in sorted(javaproperties.load(file).keys()):
        keys.append(
            PropertyKey(key, full_class_name=full_class_name, acronyms=acronyms)
        )
    return keys


# The template is static: the generated class passes it only the properties that are set
TEMPLATE_TMPL = """<%- | Hash[String, String] $properties | -%>
<% $properties.each |$key, $value| { -%>
<%= $key %> = <%= $value %>
<% } -%>
"""


# The @see URL in the generated class documentation is longer than the line limit
# pylint: disable=line-too-long
class_tmpl = Template(
    """# @summary
#   Write the `application.properties` file.
#
# This class writes the `application.properties` file for the AEM
# Orchestrator. It is auto-generated and should not be modified by hand.
# Documentation for each of the properties can be found in the example
# `application.properties` from which it is generated. (see below)
#
# _Note:_ This is an internal class that shouldn't be used directly. It is
# included by the `aem_orchestrator` class. You can change values for its
# parameters using Hiera.
#
# @see https://github.com/shinesolutions/aem-orchestrator/blob/master/src/main/resources/application.properties
#   The example AEM Orchestrator file.
#
# @param path
#   The path to the application.properties file on disk. Required.
#
# @param owner
#   The user that should own the application.properties file. This user is *not*
#   created by this module and should be managed elsewhere. Required.
#
# @param group
#   The group that should own the application.properties file. This group is
#   *not* created by this module and should be managed elsewhere. Required.
#
# @param mode
#   The mode of the application.properties file. Passed to the `file` resource.
#
{% for property in properties %}
# @param {{ property.snake_case }}
#   {{ property.doco }}
#
{% endfor %}
# Copyright © 2017-2021 Shine Solutions Group, unless otherwise noted.
#
class {{ full_class_name }} (
  String $path,
  String $owner,
  String $group,
  String $mode,

{% for property in properties %}
  Optional[String] ${{ property.snake_case }} = undef,
{% endfor %}
) {
  $properties = {
{% for property in properties %}
    {{ ("'" ~ property.key ~ "'").ljust(key_width) }} => ${{ property.snake_case }},
{% endfor %}
  }

  file { $path:
    ensure  => file,
    owner   => $owner,
    group   => $group,
    mode    => $mode,
    content => epp('{{ template_path }}', {
      'properties' => $properties.filter |$key, $value| { $value =~ NotUndef },
    }),
  }
}
""",
    trim_blocks=True,
    lstrip_blocks=True,
    keep_trailing_newline=True,
)
# pylint: enable=line-too-long

spec_tmpl = Template(
    """require 'spec_helper'
describe '{{ full_class_name }}' do
  context 'with defaults for all parameters' do
    it { is_expected.to contain_class('{{ full_class_name }}') }
  end
{% for property in properties %}
  context 'with {{ property.snake_case }} => foo' do
    let(:params) { { {{ property.snake_case }}: 'foo', path: '/tmp/foo', } }

    it { is_expected.to contain_file('/tmp/foo').with_content(%r{^{{ property.key }} = foo}) }
  end
{% endfor %}
end
""",
    trim_blocks=True,
    lstrip_blocks=True,
    keep_trailing_newline=True,
)


def main() -> None:
    """Generate the Puppet class, EPP template and spec from an example file."""
    args = parse_args()
    print(f'{sys.argv[0]} version {__version__}', file=sys.stderr)

    full_class_name = args.class_name.strip(':')
    if args.class_prefix:
        full_class_name = f"{args.class_prefix.strip(':')}::{full_class_name}"

    if args.file == '-':
        keys = parse_example_file(
            sys.stdin, full_class_name, acronyms=args.acronym
        )
    else:
        with open(args.file, encoding='utf-8') as properties_file:
            keys = parse_example_file(
                properties_file, full_class_name, acronyms=args.acronym
            )

    template_path = Path(args.template_file).name
    if args.class_prefix:
        prefix_first = args.class_prefix.strip(':').split('::')[0]
        template_path = str(Path(prefix_first) / template_path)

    # Ensure output directories exist if writing to nested paths
    Path(args.template_file).parent.mkdir(parents=True, exist_ok=True)
    Path(args.class_file).parent.mkdir(parents=True, exist_ok=True)
    Path(args.spec_file).parent.mkdir(parents=True, exist_ok=True)

    with open(args.template_file, 'w', encoding='utf-8') as template_file:
        template_file.write(TEMPLATE_TMPL)

    with open(args.class_file, 'w', encoding='utf-8') as class_file:
        class_file.write(
            class_tmpl.render(
                full_class_name=full_class_name,
                template_path=template_path,
                properties=keys,
                key_width=max(len(key.key) for key in keys) + 2,
            )
        )

    with open(args.spec_file, 'w', encoding='utf-8') as spec_file:
        spec_file.write(
            spec_tmpl.render(
                full_class_name=full_class_name,
                properties=keys,
            )
        )


if __name__ == '__main__':
    main()
